# Web app (Next.js)
DATABASE_URL=postgresql://lumi:lumi@localhost:5432/lumi
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3000

# First-admin bootstrap (no open registration)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Internal bridge API (app -> mqtt-bridge or fake-bridge)
BRIDGE_URL=http://localhost:4000
BRIDGE_TOKEN=change-me-shared-secret
BRIDGE_PORT=4000

# mqtt-bridge (real hardware) — not required when using fake-bridge (pnpm bridge:fake)
MQTT_URL=mqtt://localhost:1883
HUE_BRIDGE_IP=192.168.1.2

# Fake-bridge only (pnpm bridge:fake): reuses BRIDGE_PORT + BRIDGE_TOKEN above; no MQTT/Hue needed.
# Do not run fake-bridge and the real bridge on the same BRIDGE_PORT at once.
# FAKE_SENSOR_MS — flip all SENSOR devices on this interval (ms). Unset/0 = disabled. ≥5000 recommended.
# FAKE_SENSOR_MS=5000

# Docker compose
POSTGRES_USER=lumi
POSTGRES_PASSWORD=lumi
POSTGRES_DB=lumi
APP_HOST=lumi.local
