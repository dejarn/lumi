# Web app (Next.js)
DATABASE_URL=postgresql://lumi:lumi@localhost:5432/lumi
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3000

# First-admin bootstrap (no open registration)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
# Set to true to allow env creds login even when an active ADMIN already exists (ops recovery only)
# ALLOW_ADMIN_BOOTSTRAP=true

# Internal bridge API (app -> mqtt-bridge or fake-bridge)
BRIDGE_URL=http://localhost:4000
BRIDGE_TOKEN=change-me-shared-secret
BRIDGE_PORT=4000

# mqtt-bridge (real hardware) — not required when using fake-bridge (pnpm bridge:fake)
MQTT_URL=mqtt://localhost:1883
HUE_BRIDGE_IP=192.168.1.2
# Pairing: press the Hue Bridge link button, then within 30s:
#   curl -k -X POST https://$HUE_BRIDGE_IP/api -d '{"devicetype":"lumi#bridge","generateclientkey":true}'
# → use the returned "username" value here. Empty = Hue integration disabled.
# HUE_APP_KEY=
# HUE_POLL_MS=30000

# Fake-bridge only (pnpm bridge:fake): reuses BRIDGE_PORT + BRIDGE_TOKEN above; no MQTT/Hue needed.
# Do not run fake-bridge and the real bridge on the same BRIDGE_PORT at once.
# FAKE_SENSOR_MS — flip all SENSOR devices on this interval (ms). Unset/0 = disabled. ≥5000 recommended.
# FAKE_SENSOR_MS=5000

# Docker compose
# MQTT broker — per-role credentials (see mosquitto/acl for topic restrictions).
# Three accounts: bridge (mqtt-bridge), z2m (Zigbee2MQTT), nodes (ESP32 fleet).
# The deploy workflow generates mosquitto/passwd from these secrets automatically.
# ESP32 nodes must be configured with the 'nodes' account + MQTT_NODES_PASSWORD.
# Transition: keep the old single account in passwd alongside the new ones during
# the firmware rollout window, then remove it once all nodes are updated.
MQTT_BRIDGE_PASSWORD=change-me-in-production
MQTT_Z2M_PASSWORD=change-me-in-production
MQTT_NODES_PASSWORD=change-me-in-production
POSTGRES_USER=lumi
POSTGRES_PASSWORD=lumi
POSTGRES_DB=lumi
APP_HOST=lumi.local
